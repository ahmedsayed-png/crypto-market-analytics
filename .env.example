# ==============================================================================
# Environment Configuration Placeholder (.env.example)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# ---------------------------------------------------------------------------
# Image versions
# ---------------------------------------------------------------------------
HADOOP_IMAGE_TAG=2.0.0-hadoop3.2.1-java8
SPARK_IMAGE_TAG=3.3.0-hadoop3.3
KAFKA_IMAGE_TAG=3.9.2
KAFKA_UI_IMAGE_TAG=latest
AIRFLOW_BASE_IMAGE=apache/airflow:2.9.3-python3.11
POSTGRES_IMAGE_TAG=13
SUPERSET_IMAGE_TAG=4.1.2

# Spark client library version
PYSPARK_VERSION=3.3.0
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.3.0

# ---------------------------------------------------------------------------
# Host Ports
# ---------------------------------------------------------------------------
NAMENODE_UI_PORT=9870
DATANODE_UI_PORT=9864
HDFS_RPC_PORT=9000

SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_UI_PORT=8081

JUPYTER_PORT=8888

KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8090

AIRFLOW_WEBSERVER_PORT=8082

POSTGRES_DW_PORT=5432
SUPERSET_PORT=8088

# ---------------------------------------------------------------------------
# Binance API Configuration
# ---------------------------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# ---------------------------------------------------------------------------
# Kafka Proposal Topics Configuration
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_HISTORICAL_KLINES=crypto_klines_historical
KAFKA_TOPIC_STREAMING_KLINES=crypto_klines_streaming
KAFKA_TOPIC_TRADES=market_trades
KAFKA_TOPIC_KLINES=market_klines
KAFKA_TOPIC_ORDER_BOOK=order_book_events
KAFKA_TOPIC_TICKER=ticker_events
KAFKA_TOPIC_ALERTS=alerts_events

# ---------------------------------------------------------------------------
# HDFS Configuration
# ---------------------------------------------------------------------------
HADOOP_NAMENODE_URL=hdfs://namenode:9000
HDFS_STORAGE_PATH=/crypto_analytics/data

# ---------------------------------------------------------------------------
# PostgreSQL Data Warehouse Configuration
# ---------------------------------------------------------------------------
POSTGRES_DW_DB=crypto_dw
POSTGRES_DW_USER=crypto_admin
POSTGRES_DW_PASSWORD=crypto_secure_password_123

# ---------------------------------------------------------------------------
# Airflow Configuration
# ---------------------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Superset Configuration
# ---------------------------------------------------------------------------
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_SECRET_KEY=crypto-market-analytics-superset-secret-key-2026
