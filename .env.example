# ==============================================================================
# Environment Configuration Placeholder (.env.example)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Binance API Configuration
# ------------------------------------------------------------------------------
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# ------------------------------------------------------------------------------
# 2. Apache Kafka Configuration
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HISTORICAL_TOPIC=crypto_klines_historical
KAFKA_STREAMING_TOPIC=crypto_klines_streaming
KAFKA_ZOOKEEPER_CONNECT=localhost:2181

# ------------------------------------------------------------------------------
# 3. HDFS / Hadoop Configuration
# ------------------------------------------------------------------------------
HADOOP_NAMENODE_URL=hdfs://localhost:9000
HDFS_STORAGE_PATH=/crypto_analytics/data

# ------------------------------------------------------------------------------
# 4. PostgreSQL Data Warehouse Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_dw
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# 5. Apache Spark Configuration
# ------------------------------------------------------------------------------
SPARK_MASTER_URL=spark://localhost:7077
SPARK_APP_NAME=CryptoMarketAnalytics

# ------------------------------------------------------------------------------
# 6. Apache Airflow Configuration
# ------------------------------------------------------------------------------
AIRFLOW_USER=airflow_admin
AIRFLOW_PASSWORD=your_airflow_password_here
AIRFLOW_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 7. Apache Superset Configuration
# ------------------------------------------------------------------------------
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=your_superset_password_here
SUPERSET_SECRET_KEY=your_superset_secret_key_here
